DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5432/app_db

# --- Interactive debugging (debugpy, Docker) ---
# Enable in .env or use: docker compose -f docker-compose.yml -f docker-compose.debug.yml up --build api
# Then in Cursor/VS Code: Run → "Docker API: attach (debugpy)" (.vscode/launch.json).
# DEBUGPY_ENABLE=1
# DEBUGPY_WAIT=1
# DEBUGPY_PORT=5678

# --- Free tier / trial (Model Studio International, Singapore) ---
# Alibaba applies free token/image quotas to the International (Singapore) DashScope endpoint — not to
# dedicated “MaaS” workspace URLs in EU/US. Activate Model Studio (intl), then: Pay-as-you-go → API keys
# to create DASHSCOPE_API_KEY. Monitor remaining free usage in the console (e.g. model usage / billing).
# Policy and amounts change over time (e.g. per-model token bundles, limited image generations): see
# https://www.alibabacloud.com/help/en/model-studio/new-free-quota
# and pricing: https://www.alibabacloud.com/help/doc-detail/2987148.html
# For experimentation with this repo, prefer clearing MaaS overrides and using:
#   DASHSCOPE_BASE_HTTP_API_URL=https://dashscope-intl.aliyuncs.com/api/v1
#   (same URL for reasoning + editing unless you split keys later)

# --- Alibaba Cloud: Model Studio / MaaS (DashScope-compatible API) ---
# Create an API key in the Model Studio / MaaS console. Use the API root your console shows (must end with /api/v1).
# Docs: https://www.alibabacloud.com/help/en/model-studio/get-api-key
#
# Dedicated MaaS workspace (example: EU Central — same root for reasoning + image edit if your console shows one URL):
# Use one key for everything:
# DASHSCOPE_API_KEY=
# Or separate keys (recommended if Alibaba issued two):
DASHSCOPE_REASONING_API_KEY=
DASHSCOPE_EDITING_API_KEY=
# Fallback if the role-specific keys above are empty:
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_HTTP_API_URL=https://ws-isphzmjfmoi305e8.eu-central-1.maas.aliyuncs.com/api/v1
#
# If Alibaba gives separate gateway URLs later, set these (non-empty overrides the base per call type):
# DASHSCOPE_REASONING_BASE_HTTP_API_URL=
# DASHSCOPE_EDITING_BASE_HTTP_API_URL=
#
# Public DashScope (alternative to MaaS workspace):
# DASHSCOPE_BASE_HTTP_API_URL=https://dashscope-intl.aliyuncs.com/api/v1
# China (Beijing) console:
# DASHSCOPE_BASE_HTTP_API_URL=https://dashscope.aliyuncs.com/api/v1

# OpenAI-compatible chat for QWEN_TEXT_MODEL (e.g. qwen3-max). Official intl example:
# DASHSCOPE_OPENAI_COMPATIBLE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# (Uses DASHSCOPE_OPENAI_API_KEY when set, else the same key as MaaS / VL.)
DASHSCOPE_OPENAI_COMPATIBLE_BASE_URL=

# Intl pay-as-you-go key for OpenAI-compatible / Responses planner only (when base URL is MaaS sk-ws-...).
# DASHSCOPE_OPENAI_API_KEY=
# DASHSCOPE_OPENAI_COMPATIBLE_BASE_URL for planner calls only (client.responses.create + extra_body).
# Official intl example:
# DASHSCOPE_OPENAI_RESPONSES_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v2/apps/protocols/compatible-mode/v1
DASHSCOPE_OPENAI_RESPONSES_BASE_URL=
# Set true to pass enable_thinking (vendor extension via extra_body), matching Model Studio samples.
DASHSCOPE_PLANNER_ENABLE_THINKING=false

# Model ids must match what is deployed on each gateway (console). Official Model Studio names:
# - VL: MultiModalConversation on .../api/v1 — e.g. qwen-vl-max
# - Embeddings: TextEmbedding.call — e.g. text-embedding-v4
# - Text JSON planner: Responses URL (above) > chat compatible > native Generation — e.g. qwen3-max / qwen-max
# - Image edit: MultiModalConversation — e.g. qwen-image-edit-max (result_format=message, stream=false, etc.)
#
# If chat returns "Model not exist" / InvalidParameter, your MaaS workspace almost always uses different ids:
# open Model Studio → your endpoint → copy the exact "Model" / deployment name into QWEN_VISION_MODEL (first chat uses VL).
QWEN_VISION_MODEL=qwen-vl-max
QWEN_TEXT_MODEL=qwen3-max
QWEN_IMAGE_EDIT_MODEL=qwen-image-edit-max
# Text-to-image for chat-generated reference previews (wan2.6-image).
# Must use the intl pay-as-you-go gateway + sk-... key — NOT workspace MaaS.
QWEN_IMAGE_GENERATION_MODEL=wan2.5-t2i-preview
DASHSCOPE_GENERATION_BASE_HTTP_API_URL=https://dashscope-intl.aliyuncs.com/api/v1
DASHSCOPE_GENERATION_API_KEY=
# Or reuse the intl planner key when set:
# DASHSCOPE_OPENAI_API_KEY=
QWEN_EMBEDDING_MODEL=text-embedding-v4

# Qdrant vector size must match the embedding model (v4 ≠ v2). Recreate or reindex the collection if you switch models.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=style_refs
